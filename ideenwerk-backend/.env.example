DATABASE_URL=postgres://werk:change-me@localhost:5432/werk
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SUBMISSION_RATE_LIMIT=20
REPORT_RATE_LIMIT=30
PRIVACY_RATE_LIMIT=30

# Zweite, gemeinsame Rate-Limit-Schicht für mehrere API-Instanzen.
# Lokal kann sie deaktiviert bleiben; produktiv soll REQUIRE_DISTRIBUTED_RATE_LIMIT=true gesetzt werden.
DISTRIBUTED_RATE_LIMIT=false
REQUIRE_DISTRIBUTED_RATE_LIMIT=false
# Mindestens 32 Zeichen; produktiv aus Secret-Management, nicht aus Git.
ABUSE_HASH_SECRET=change-me-with-at-least-32-characters

WORKER_POLL_MS=1500
LEXICAL_DUPLICATE_THRESHOLD=0.90
# WORKER_ID=ideenwerk-worker-1

# Semantikschicht: Standard bleibt providerlos/fail-open.
SEMANTIC_PROVIDER=fallback
# Für einen späteren JSON-kompatiblen semantischen Dienst:
# SEMANTIC_PROVIDER=http_json
# SEMANTIC_ENDPOINT=https://example.invalid/ideenwerk/semantic
# SEMANTIC_API_KEY=change-me
SEMANTIC_FAIL_OPEN=true
SEMANTIC_TIMEOUT_MS=15000

# Retention: technische Defaults, vor Produktivbetrieb juristisch freizugeben.
RETENTION_POLICY_VERSION=2026-09-03-v1
RETENTION_DRY_RUN=true
RETENTION_DONE_JOB_DAYS=14
RETENTION_DEAD_JOB_DAYS=90
RETENTION_STATUS_ACCESS_GRACE_DAYS=30
RETENTION_MODERATION_DETAILS_DAYS=180

# Backup/Restore – Restore nur gegen explizite isolierte Testdatenbank.
BACKUP_DIR=./backups
# RESTORE_DATABASE_URL=postgres://werk:change-me@localhost:5432/werk_restore
# BACKUP_FILE=./backups/ideenwerk-....dump
# RESTORE_CONFIRM=I_UNDERSTAND_TEST_RESTORE

# Reproduzierbare interne Lasttests
SYNTHETIC_COUNT=100000
SYNTHETIC_BATCH=1000
# SYNTHETIC_RUN_ID=RTEST001
BENCHMARK_INTERVAL_MS=2000
BENCHMARK_MAX_SECONDS=900
