DATABASE_URL=postgres://werk:change-me@localhost:5432/werk
PORT=3000
SUBMISSION_RATE_LIMIT=20
REPORT_RATE_LIMIT=30
WORKER_POLL_MS=1500
LEXICAL_DUPLICATE_THRESHOLD=0.90
# WORKER_ID=ideenwerk-worker-1

# Semantikschicht: Standard bleibt providerlos/fail-open.
SEMANTIC_PROVIDER=fallback
# Für einen späteren JSON-kompatiblen semantischen Dienst:
# SEMANTIC_PROVIDER=http_json
# SEMANTIC_ENDPOINT=https://example.invalid/ideenwerk/semantic
# SEMANTIC_API_KEY=change-me
SEMANTIC_FAIL_OPEN=true
SEMANTIC_TIMEOUT_MS=15000

# Reproduzierbare interne Lasttests
SYNTHETIC_COUNT=100000
SYNTHETIC_BATCH=1000
# SYNTHETIC_RUN_ID=RTEST001
BENCHMARK_INTERVAL_MS=2000
BENCHMARK_MAX_SECONDS=900
